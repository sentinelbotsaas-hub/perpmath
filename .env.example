# perpmath live (0.2) reads Bybit TESTNET credentials from these two
# environment variables and nowhere else. perpmath does not read this file;
# copy it to .env (ignored by git), fill it in, and load it in your shell, e.g.
#   set -a; . ./.env; set +a          (bash / zsh)
#
# Create the key on https://testnet.bybit.com, NOT on bybit.com.
# Permissions: Contract -> Orders and Positions only. No withdrawal, no
# transfer. perpmath refuses to start with a key that can withdraw or transfer.
#
# --dry-run needs neither variable.
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
